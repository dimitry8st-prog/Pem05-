# Скопируйте этот файл в .env и заполните свои значения

# 1. Получите токен у @BotFather в Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# 2. Получите ключ на https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# База данных (по умолчанию SQLite, для продакшена замените на PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/contract_wizard
DATABASE_URL=sqlite:///contract_wizard.db

# Папка для хранения файлов
UPLOAD_DIR=./uploads

# Лимиты
MAX_FILE_SIZE_MB=20
FREE_DAILY_LIMIT=10

# Модель Claude
CLAUDE_MODEL=claude-sonnet-4-6
MAX_TOKENS=2000
